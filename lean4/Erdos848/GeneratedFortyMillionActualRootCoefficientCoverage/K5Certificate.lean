          200_000_000)) :=
      List.mem_filter.mpr ⟨hrow, by simpa using hUpper⟩
    have hactual : row ∈ k5PrefixGroup0000ActualRows := by
      rw [k5PrefixGroup0000ActualRows_eq_filter]
      exact hfiltered
    exact (List.all_eq_true.mp k5PrefixGroup0000_actual_global_root_coefficient_passes)
      row.1 (List.mem_map.mpr ⟨row, hactual, rfl⟩)
