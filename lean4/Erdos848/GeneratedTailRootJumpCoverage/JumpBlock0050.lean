import Erdos848.TailRootJumpChecker
import Erdos848.GeneratedTailPrimeIntervalCoverage.Block0050

namespace Erdos848.GeneratedTailRootJumpCoverage

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

theorem jumpBlock0050_passes :
    Erdos848.GeneratedTailPrimeIntervalCoverage.blockTree0050.allPrimeRanks
      9805 Erdos848.fiveMillionOddRoot7JumpPasses = true := by
  decide

end Erdos848.GeneratedTailRootJumpCoverage
