        k3PrefixGroup0030NormalLookup
        k3PrefixGroup0030TwistLookup) = true := by
  simp only [k3PrefixGroup0030MaskPrimes, List.all_append]
  rw [k3PrefixGroup0030_mask_group0000_passes]
  rw [k3PrefixGroup0030_mask_group0003_passes]
  rw [k3PrefixGroup0030_mask_group0004_passes]
  rw [k3PrefixGroup0030_mask_group0005_passes]
  rw [k3PrefixGroup0030_mask_group0006_passes]
  rw [k3PrefixGroup0030_mask_group0007_passes]
  rfl

theorem k3PrefixGroup0030_certified
    {support : List ℕ} (hsupport : support ∈ k3PrefixGroup0030) :
    ∃ normalLookup twistLookup : ℕ → List ℕ,
      (∀ p ∈ support,
        Erdos848.twentyMillionRootMaskPassesWith
          normalLookup twistLookup p = true) ∧
      Erdos848.twentyMillionRootCorePrefixPasses
        normalLookup twistLookup rootBaseWords 3 support = true := by
  refine ⟨k3PrefixGroup0030NormalLookup,
    k3PrefixGroup0030TwistLookup, ?_,
    (List.all_eq_true.mp
      k3PrefixGroup0030_passes) support hsupport⟩
  intro p hp
  have hcovered := (List.all_eq_true.mp
    k3PrefixGroup0030_support_covered) support hsupport
  have hmem : p ∈
      k3PrefixGroup0030MaskPrimes :=
    of_decide_eq_true ((List.all_eq_true.mp hcovered) p hp)
  exact (List.all_eq_true.mp
    k3PrefixGroup0030_mask_primes_pass) p hmem

#print axioms k3PrefixGroup0030_certified

end Erdos848.GeneratedTailTwentyMillionRootCoverage
