theorem k3PrefixGroup0030_support_covered :
    k3PrefixGroup0030.all (fun support =>
      support.all (fun p =>
        decide (p ∈ k3PrefixGroup0030MaskPrimes))) = true := by
  rfl

theorem k3PrefixGroup0030_passes :
    k3PrefixGroup0030.all
      (Erdos848.twentyMillionRootCorePrefixPasses
        k3PrefixGroup0030NormalLookup
        k3PrefixGroup0030TwistLookup rootBaseWords 3) = true := by
  rfl

theorem k3PrefixGroup0030_mask_group0000_passes :
    rootMaskSemanticGroup0000.all
      (Erdos848.twentyMillionRootMaskPassesWith
        k3PrefixGroup0030NormalLookup
        k3PrefixGroup0030TwistLookup) = true := by
  apply List.all_eq_true.mpr
  intro p hp
  have hlocal := (List.all_eq_true.mp
    rootMaskSemanticGroup0000_passes) p hp
  have hnormal : k3PrefixGroup0030NormalLookup p =
      rootNormalQrMaskWords0000 p := by
    simp only [rootMaskSemanticGroup0000,
      List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> rfl
  have htwist : k3PrefixGroup0030TwistLookup p =
      rootTwistQrMaskWords0000 p := by
    simp only [rootMaskSemanticGroup0000,
      List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> rfl
  rw [Erdos848.twentyMillionRootMaskPassesWith_congr_at
    hnormal htwist]
  exact hlocal

