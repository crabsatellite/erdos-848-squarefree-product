theorem k3PrefixGroup0075_support_covered :
    k3PrefixGroup0075.all (fun support =>
      support.all (fun p =>
        decide (p ∈ k3PrefixGroup0075MaskPrimes))) = true := by
  rfl

theorem k3PrefixGroup0075_passes :
    k3PrefixGroup0075.all
      (Erdos848.twentyMillionRootCorePrefixPasses
        k3PrefixGroup0075NormalLookup
        k3PrefixGroup0075TwistLookup rootBaseWords 3) = true := by
  rfl

theorem k3PrefixGroup0075_mask_group0001_passes :
    rootMaskSemanticGroup0001.all
      (Erdos848.twentyMillionRootMaskPassesWith
        k3PrefixGroup0075NormalLookup
        k3PrefixGroup0075TwistLookup) = true := by
  apply List.all_eq_true.mpr
  intro p hp
  have hlocal := (List.all_eq_true.mp
    rootMaskSemanticGroup0001_passes) p hp
  have hnormal : k3PrefixGroup0075NormalLookup p =
      rootNormalQrMaskWords0001 p := by
    simp only [rootMaskSemanticGroup0001,
      List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> rfl
  have htwist : k3PrefixGroup0075TwistLookup p =
      rootTwistQrMaskWords0001 p := by
    simp only [rootMaskSemanticGroup0001,
      List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> rfl
  rw [Erdos848.twentyMillionRootMaskPassesWith_congr_at
    hnormal htwist]
  exact hlocal

