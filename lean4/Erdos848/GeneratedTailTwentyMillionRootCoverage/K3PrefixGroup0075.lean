theorem k3PrefixGroup0075_mask_primes_pass :
    k3PrefixGroup0075MaskPrimes.all
      (Erdos848.twentyMillionRootMaskPassesWith
        k3PrefixGroup0075NormalLookup
        k3PrefixGroup0075TwistLookup) = true := by
  simp only [k3PrefixGroup0075MaskPrimes, List.all_append]
  rw [k3PrefixGroup0075_mask_group0001_passes]
  rw [k3PrefixGroup0075_mask_group0002_passes]
  rw [k3PrefixGroup0075_mask_group0003_passes]
  rw [k3PrefixGroup0075_mask_group0004_passes]
  rw [k3PrefixGroup0075_mask_group0005_passes]
  rw [k3PrefixGroup0075_mask_group0006_passes]
  rfl

theorem k3PrefixGroup0075_certified
    {support : List ℕ} (hsupport : support ∈ k3PrefixGroup0075) :
    ∃ normalLookup twistLookup : ℕ → List ℕ,
      (∀ p ∈ support,
        Erdos848.twentyMillionRootMaskPassesWith
          normalLookup twistLookup p = true) ∧
      Erdos848.twentyMillionRootCorePrefixPasses
        normalLookup twistLookup rootBaseWords 3 support = true := by
  refine ⟨k3PrefixGroup0075NormalLookup,
    k3PrefixGroup0075TwistLookup, ?_,
    (List.all_eq_true.mp
      k3PrefixGroup0075_passes) support hsupport⟩
  intro p hp
  have hcovered := (List.all_eq_true.mp
    k3PrefixGroup0075_support_covered) support hsupport
  have hmem : p ∈
      k3PrefixGroup0075MaskPrimes :=
    of_decide_eq_true ((List.all_eq_true.mp hcovered) p hp)
  exact (List.all_eq_true.mp
    k3PrefixGroup0075_mask_primes_pass) p hmem

#print axioms k3PrefixGroup0075_certified

end Erdos848.GeneratedTailTwentyMillionRootCoverage
