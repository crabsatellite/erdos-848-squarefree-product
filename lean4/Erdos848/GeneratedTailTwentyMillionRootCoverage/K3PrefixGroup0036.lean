  simp only [k3PrefixGroup0036MaskPrimes, List.all_append]
  rw [k3PrefixGroup0036_mask_group0000_passes]
  rw [k3PrefixGroup0036_mask_group0003_passes]
  rw [k3PrefixGroup0036_mask_group0004_passes]
