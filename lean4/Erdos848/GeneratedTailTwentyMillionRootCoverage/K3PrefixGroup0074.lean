        k3PrefixGroup0074TwistLookup) = true := by
  simp only [k3PrefixGroup0074MaskPrimes, List.all_append]
  rw [k3PrefixGroup0074_mask_group0001_passes]
  rw [k3PrefixGroup0074_mask_group0002_passes]
  rw [k3PrefixGroup0074_mask_group0003_passes]
