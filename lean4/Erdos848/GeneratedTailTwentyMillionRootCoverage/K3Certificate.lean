theorem k3_certified_of_mem
    {support : List ℕ}
    (hsupport : support ∈
      Erdos848.twentyMillionRootFeasiblePrefixes 3) :
    ∃ normalLookup twistLookup : ℕ → List ℕ,
      (∀ p ∈ support,
        Erdos848.twentyMillionRootMaskPassesWith
          normalLookup twistLookup p = true) ∧
      Erdos848.twentyMillionRootCorePrefixPasses
        normalLookup twistLookup rootBaseWords 3 support = true := by
  rw [← k3CertifiedPrefixes_eq] at hsupport
  simp only [k3CertifiedPrefixes, List.mem_append] at hsupport
  rcases hsupport with ((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((h0 | h1) | h2) | h3) | h4) | h5) | h6) | h7) | h8) | h9) | h10) | h11) | h12) | h13) | h14) | h15) | h16) | h17) | h18) | h19) | h20) | h21) | h22) | h23) | h24) | h25) | h26) | h27) | h28) | h29) | h30) | h31) | h32) | h33) | h34) | h35) | h36) | h37) | h38) | h39) | h40) | h41) | h42) | h43) | h44) | h45) | h46) | h47) | h48) | h49) | h50) | h51) | h52) | h53) | h54) | h55) | h56) | h57) | h58) | h59) | h60) | h61) | h62) | h63) | h64) | h65) | h66) | h67) | h68) | h69) | h70) | h71) | h72) | h73) | h74) | h75) | h76) | h77) | h78) | h79) | h80) | h81) | h82) | h83) | h84) | h85) | h86) | h87) | h88) | h89) | h90)
