theorem k4PrefixGroup0043_support_covered :
    k4PrefixGroup0043.all (fun support =>
      support.all (fun p =>
        decide (p ∈ k4PrefixGroup0043MaskPrimes))) = true := by
  rfl

theorem k4PrefixGroup0043_passes :
    k4PrefixGroup0043.all
      (Erdos848.twentyMillionRootCorePrefixPasses
        k4PrefixGroup0043NormalLookup
        k4PrefixGroup0043TwistLookup rootBaseWords 4) = true := by
  rfl

theorem k4PrefixGroup0043_mask_group0000_passes :
    rootMaskSemanticGroup0000.all
      (Erdos848.twentyMillionRootMaskPassesWith
        k4PrefixGroup0043NormalLookup
        k4PrefixGroup0043TwistLookup) = true := by
  apply List.all_eq_true.mpr
  intro p hp
  have hlocal := (List.all_eq_true.mp
    rootMaskSemanticGroup0000_passes) p hp
  have hnormal : k4PrefixGroup0043NormalLookup p =
      rootNormalQrMaskWords0000 p := by
    simp only [rootMaskSemanticGroup0000,
      List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> rfl
  have htwist : k4PrefixGroup0043TwistLookup p =
      rootTwistQrMaskWords0000 p := by
    simp only [rootMaskSemanticGroup0000,
      List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> rfl
  rw [Erdos848.twentyMillionRootMaskPassesWith_congr_at
    hnormal htwist]
  exact hlocal

