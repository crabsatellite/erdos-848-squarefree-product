        k3PrefixGroup0064NormalLookup
        k3PrefixGroup0064TwistLookup) = true := by
  simp only [k3PrefixGroup0064MaskPrimes, List.all_append]
  rw [k3PrefixGroup0064_mask_group0001_passes]
  rw [k3PrefixGroup0064_mask_group0002_passes]
  rw [k3PrefixGroup0064_mask_group0004_passes]
  rw [k3PrefixGroup0064_mask_group0005_passes]
  rw [k3PrefixGroup0064_mask_group0006_passes]
  rw [k3PrefixGroup0064_mask_group0007_passes]
