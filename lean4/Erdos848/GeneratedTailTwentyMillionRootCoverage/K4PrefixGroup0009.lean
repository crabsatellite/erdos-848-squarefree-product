  simp only [k4PrefixGroup0009MaskPrimes, List.all_append]
  rw [k4PrefixGroup0009_mask_group0000_passes]
  rw [k4PrefixGroup0009_mask_group0001_passes]
  rw [k4PrefixGroup0009_mask_group0002_passes]
  rw [k4PrefixGroup0009_mask_group0003_passes]
  rw [k4PrefixGroup0009_mask_group0004_passes]
  rw [k4PrefixGroup0009_mask_group0005_passes]
