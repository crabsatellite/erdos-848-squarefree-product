theorem k4PrefixGroup0009_support_covered :
    k4PrefixGroup0009.all (fun support =>
      support.all (fun p =>
        decide (p ∈ k4PrefixGroup0009MaskPrimes))) = true := by
  rfl

theorem k4PrefixGroup0009_passes :
    k4PrefixGroup0009.all
      (Erdos848.twentyMillionRootCorePrefixPasses
        k4PrefixGroup0009NormalLookup
        k4PrefixGroup0009TwistLookup rootBaseWords 4) = true := by
  rfl

theorem k4PrefixGroup0009_mask_group0000_passes :
    rootMaskSemanticGroup0000.all
      (Erdos848.twentyMillionRootMaskPassesWith
        k4PrefixGroup0009NormalLookup
        k4PrefixGroup0009TwistLookup) = true := by
  apply List.all_eq_true.mpr
  intro p hp
  have hlocal := (List.all_eq_true.mp
    rootMaskSemanticGroup0000_passes) p hp
  have hnormal : k4PrefixGroup0009NormalLookup p =
      rootNormalQrMaskWords0000 p := by
    simp only [rootMaskSemanticGroup0000,
      List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> rfl
  have htwist : k4PrefixGroup0009TwistLookup p =
      rootTwistQrMaskWords0000 p := by
    simp only [rootMaskSemanticGroup0000,
      List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> rfl
  rw [Erdos848.twentyMillionRootMaskPassesWith_congr_at
    hnormal htwist]
  exact hlocal

