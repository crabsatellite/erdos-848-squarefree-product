theorem k3PrefixGroup0070_certified
    {support : List ℕ} (hsupport : support ∈ k3PrefixGroup0070) :
    ∃ normalLookup twistLookup : ℕ → List ℕ,
      (∀ p ∈ support,
        Erdos848.twentyMillionRootMaskPassesWith
          normalLookup twistLookup p = true) ∧
      Erdos848.twentyMillionRootCorePrefixPasses
        normalLookup twistLookup rootBaseWords 3 support = true := by
  refine ⟨k3PrefixGroup0070NormalLookup,
    k3PrefixGroup0070TwistLookup, ?_,
    (List.all_eq_true.mp
      k3PrefixGroup0070_passes) support hsupport⟩
  intro p hp
  have hcovered := (List.all_eq_true.mp
    k3PrefixGroup0070_support_covered) support hsupport
  have hmem : p ∈
      k3PrefixGroup0070MaskPrimes :=
    of_decide_eq_true ((List.all_eq_true.mp hcovered) p hp)
  exact (List.all_eq_true.mp
    k3PrefixGroup0070_mask_primes_pass) p hmem

#print axioms k3PrefixGroup0070_certified

