        k3PrefixGroup0066NormalLookup
        k3PrefixGroup0066TwistLookup) = true := by
  simp only [k3PrefixGroup0066MaskPrimes, List.all_append]
  rw [k3PrefixGroup0066_mask_group0001_passes]
  rw [k3PrefixGroup0066_mask_group0002_passes]
  rw [k3PrefixGroup0066_mask_group0003_passes]
  rw [k3PrefixGroup0066_mask_group0004_passes]
  rw [k3PrefixGroup0066_mask_group0005_passes]
