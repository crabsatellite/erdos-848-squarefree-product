  simp only [k3PrefixGroup0054MaskPrimes, List.all_append]
  rw [k3PrefixGroup0054_mask_group0001_passes]
  rw [k3PrefixGroup0054_mask_group0003_passes]
  rw [k3PrefixGroup0054_mask_group0004_passes]
