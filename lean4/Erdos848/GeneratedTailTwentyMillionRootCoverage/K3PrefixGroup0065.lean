        k3PrefixGroup0065NormalLookup
        k3PrefixGroup0065TwistLookup) = true := by
  simp only [k3PrefixGroup0065MaskPrimes, List.all_append]
  rw [k3PrefixGroup0065_mask_group0001_passes]
  rw [k3PrefixGroup0065_mask_group0002_passes]
  rw [k3PrefixGroup0065_mask_group0003_passes]
  rw [k3PrefixGroup0065_mask_group0004_passes]
  rw [k3PrefixGroup0065_mask_group0005_passes]
  rw [k3PrefixGroup0065_mask_group0006_passes]
  rfl

theorem k3PrefixGroup0065_certified
    {support : List ℕ} (hsupport : support ∈ k3PrefixGroup0065) :
    ∃ normalLookup twistLookup : ℕ → List ℕ,
      (∀ p ∈ support,
        Erdos848.twentyMillionRootMaskPassesWith
          normalLookup twistLookup p = true) ∧
      Erdos848.twentyMillionRootCorePrefixPasses
        normalLookup twistLookup rootBaseWords 3 support = true := by
  refine ⟨k3PrefixGroup0065NormalLookup,
    k3PrefixGroup0065TwistLookup, ?_,
    (List.all_eq_true.mp
      k3PrefixGroup0065_passes) support hsupport⟩
  intro p hp
  have hcovered := (List.all_eq_true.mp
    k3PrefixGroup0065_support_covered) support hsupport
  have hmem : p ∈
      k3PrefixGroup0065MaskPrimes :=
    of_decide_eq_true ((List.all_eq_true.mp hcovered) p hp)
  exact (List.all_eq_true.mp
    k3PrefixGroup0065_mask_primes_pass) p hmem

#print axioms k3PrefixGroup0065_certified

end Erdos848.GeneratedTailTwentyMillionRootCoverage
