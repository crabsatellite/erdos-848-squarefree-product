theorem k4PrefixGroup0047_certified
    {support : List ℕ} (hsupport : support ∈ k4PrefixGroup0047) :
    ∃ normalLookup twistLookup : ℕ → List ℕ,
      (∀ p ∈ support,
        Erdos848.twentyMillionRootMaskPassesWith
          normalLookup twistLookup p = true) ∧
      Erdos848.twentyMillionRootCorePrefixPasses
        normalLookup twistLookup rootBaseWords 4 support = true := by
  refine ⟨k4PrefixGroup0047NormalLookup,
    k4PrefixGroup0047TwistLookup, ?_,
    (List.all_eq_true.mp
      k4PrefixGroup0047_passes) support hsupport⟩
  intro p hp
  have hcovered := (List.all_eq_true.mp
    k4PrefixGroup0047_support_covered) support hsupport
  have hmem : p ∈
      k4PrefixGroup0047MaskPrimes :=
    of_decide_eq_true ((List.all_eq_true.mp hcovered) p hp)
  exact (List.all_eq_true.mp
    k4PrefixGroup0047_mask_primes_pass) p hmem

#print axioms k4PrefixGroup0047_certified

