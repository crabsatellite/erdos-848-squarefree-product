  simp only [k3PrefixGroup0067MaskPrimes, List.all_append]
  rw [k3PrefixGroup0067_mask_group0001_passes]
  rw [k3PrefixGroup0067_mask_group0002_passes]
  rw [k3PrefixGroup0067_mask_group0003_passes]
  rw [k3PrefixGroup0067_mask_group0005_passes]
