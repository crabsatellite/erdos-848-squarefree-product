theorem maskSemanticGroup0009
    {p : ℕ}
    (hLower : 548 ≤ p) (hUpper : p ≤ 613)
    (hp : Erdos848.FiveMillionSupportPrime p) :
    supportQrMaskWords p =
      (Erdos848.GeneratedTailSupportCoverage.qrMaskWords p).take 11 := by
  interval_cases p <;>
    norm_num [Erdos848.FiveMillionSupportPrime] at hp
  · exact maskSemanticPrime557
  · exact maskSemanticPrime563
  · exact maskSemanticPrime569
  · exact maskSemanticPrime571
  · exact maskSemanticPrime577
  · exact maskSemanticPrime587
  · exact maskSemanticPrime593
  · exact maskSemanticPrime599
  · exact maskSemanticPrime601
  · exact maskSemanticPrime607
  · exact maskSemanticPrime613

theorem baseSupportPrimeMemGroup0009
    {p : ℕ}
    (hLower : 548 ≤ p) (hUpper : p ≤ 613)
    (hp : Erdos848.FiveMillionSupportPrime p) :
    p ∈ Erdos848.GeneratedTailSupportCoverage.supportPrimes := by
  interval_cases p <;>
    norm_num [Erdos848.FiveMillionSupportPrime] at hp
  · exact baseSupportPrimeMem557
  · exact baseSupportPrimeMem563
  · exact baseSupportPrimeMem569
  · exact baseSupportPrimeMem571
  · exact baseSupportPrimeMem577
  · exact baseSupportPrimeMem587
  · exact baseSupportPrimeMem593
  · exact baseSupportPrimeMem599
  · exact baseSupportPrimeMem601
  · exact baseSupportPrimeMem607
  · exact baseSupportPrimeMem613

theorem extensionSemanticGroup0009
    {p : ℕ}
    (hLower : 548 ≤ p) (hUpper : p ≤ 613)
    (hp : Erdos848.FiveMillionSupportPrime p) :
    Nat.Prime (supportExtensionPrime p) ∧
      p < supportExtensionPrime p ∧
      ∀ q, Erdos848.FiveMillionSupportPrime q →
        p < q → supportExtensionPrime p ≤ q := by
  interval_cases p <;>
    norm_num [Erdos848.FiveMillionSupportPrime] at hp
  · exact extensionSemanticPrime557
  · exact extensionSemanticPrime563
  · exact extensionSemanticPrime569
  · exact extensionSemanticPrime571
  · exact extensionSemanticPrime577
  · exact extensionSemanticPrime587
  · exact extensionSemanticPrime593
  · exact extensionSemanticPrime599
  · exact extensionSemanticPrime601
  · exact extensionSemanticPrime607
  · exact extensionSemanticPrime613

