namespace Erdos848.GeneratedTailGlobalPureSupportCoverage

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

theorem maskSemanticPrime557 :
    supportQrMaskWords 557 =
      (Erdos848.GeneratedTailSupportCoverage.qrMaskWords
        557).take 11 := by
  rfl

theorem baseSupportPrimeMem557 :
    557 ∈
      Erdos848.GeneratedTailSupportCoverage.supportPrimes := by
  decide

theorem extensionPrimeEq557 :
    supportExtensionPrime 557 = 563 := by
  rfl

theorem extensionSemanticPrime557 :
    Nat.Prime (supportExtensionPrime 557) ∧
      557 < supportExtensionPrime 557 ∧
      ∀ q, Erdos848.FiveMillionSupportPrime q →
        557 < q → supportExtensionPrime 557 ≤ q := by
  rw [extensionPrimeEq557]
  constructor
  · norm_num
  constructor
  · norm_num
  · intro q hq hqLower
    by_contra hnot
    have hqUpper : q < 563 :=
      Nat.lt_of_not_ge hnot
    interval_cases q <;>
      norm_num [Erdos848.FiveMillionSupportPrime] at hq

