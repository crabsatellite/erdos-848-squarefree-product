theorem k3PrefixGroup0052_mask_primes_pass :
    k3PrefixGroup0052MaskPrimes.all
      (Erdos848.tenMillionKernelRootMaskPassesWith
        k3PrefixGroup0052NormalLookup
        k3PrefixGroup0052TwistLookup) = true := by
  simp only [k3PrefixGroup0052MaskPrimes, List.all_append]
  rw [k3PrefixGroup0052_mask_group0001_passes]
  rw [k3PrefixGroup0052_mask_group0002_passes]
  rw [k3PrefixGroup0052_mask_group0003_passes]
  rw [k3PrefixGroup0052_mask_group0004_passes]
  rfl

theorem k3PrefixGroup0052_certified
    {support : List ℕ} (hsupport : support ∈ k3PrefixGroup0052) :
    ∃ normalLookup twistLookup : ℕ → List ℕ,
      (∀ p ∈ support,
        Erdos848.tenMillionKernelRootMaskPassesWith
          normalLookup twistLookup p = true) ∧
      Erdos848.tenMillionKernelRootCorePrefixPasses
        normalLookup twistLookup rootBaseWords 3 support = true := by
  refine ⟨k3PrefixGroup0052NormalLookup,
    k3PrefixGroup0052TwistLookup, ?_,
    (List.all_eq_true.mp
      k3PrefixGroup0052_passes) support hsupport⟩
  intro p hp
  have hcovered := (List.all_eq_true.mp
    k3PrefixGroup0052_support_covered) support hsupport
  have hmem : p ∈
      k3PrefixGroup0052MaskPrimes :=
    of_decide_eq_true ((List.all_eq_true.mp hcovered) p hp)
  exact (List.all_eq_true.mp
    k3PrefixGroup0052_mask_primes_pass) p hmem

#print axioms k3PrefixGroup0052_certified

