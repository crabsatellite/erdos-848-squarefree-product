theorem k3CertifiedPrefixes_eq :
    k3CertifiedPrefixes =
      Erdos848.tenMillionKernelRootFeasiblePrefixes 3 := by
  rfl

theorem k3_certified_of_mem
    {support : List ℕ}
    (hsupport : support ∈
      Erdos848.tenMillionKernelRootFeasiblePrefixes 3) :
    ∃ normalLookup twistLookup : ℕ → List ℕ,
      (∀ p ∈ support,
        Erdos848.tenMillionKernelRootMaskPassesWith
          normalLookup twistLookup p = true) ∧
      Erdos848.tenMillionKernelRootCorePrefixPasses
        normalLookup twistLookup rootBaseWords 3 support = true := by
  rw [← k3CertifiedPrefixes_eq] at hsupport
  simp only [k3CertifiedPrefixes, List.mem_append] at hsupport
  rcases hsupport with ((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((hgroup0 | hgroup1) | hgroup2) | hgroup3) | hgroup4) | hgroup5) | hgroup6) | hgroup7) | hgroup8) | hgroup9) | hgroup10) | hgroup11) | hgroup12) | hgroup13) | hgroup14) | hgroup15) | hgroup16) | hgroup17) | hgroup18) | hgroup19) | hgroup20) | hgroup21) | hgroup22) | hgroup23) | hgroup24) | hgroup25) | hgroup26) | hgroup27) | hgroup28) | hgroup29) | hgroup30) | hgroup31) | hgroup32) | hgroup33) | hgroup34) | hgroup35) | hgroup36) | hgroup37) | hgroup38) | hgroup39) | hgroup40) | hgroup41) | hgroup42) | hgroup43) | hgroup44) | hgroup45) | hgroup46) | hgroup47) | hgroup48) | hgroup49) | hgroup50) | hgroup51) | hgroup52) | hgroup53) | hgroup54) | hgroup55) | hgroup56) | hgroup57) | hgroup58) | hgroup59) | hgroup60)
