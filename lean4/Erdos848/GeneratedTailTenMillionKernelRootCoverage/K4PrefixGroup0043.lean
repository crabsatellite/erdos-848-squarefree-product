      (Erdos848.tenMillionKernelRootMaskPassesWith
        k4PrefixGroup0043NormalLookup
        k4PrefixGroup0043TwistLookup) = true := by
  simp only [k4PrefixGroup0043MaskPrimes, List.all_append]
  rw [k4PrefixGroup0043_mask_group0000_passes]
  rw [k4PrefixGroup0043_mask_group0001_passes]
  rw [k4PrefixGroup0043_mask_group0002_passes]
  rw [k4PrefixGroup0043_mask_group0003_passes]
  rw [k4PrefixGroup0043_mask_group0004_passes]
  rfl

theorem k4PrefixGroup0043_certified
    {support : List ℕ} (hsupport : support ∈ k4PrefixGroup0043) :
    ∃ normalLookup twistLookup : ℕ → List ℕ,
      (∀ p ∈ support,
        Erdos848.tenMillionKernelRootMaskPassesWith
          normalLookup twistLookup p = true) ∧
      Erdos848.tenMillionKernelRootCorePrefixPasses
        normalLookup twistLookup rootBaseWords 4 support = true := by
  refine ⟨k4PrefixGroup0043NormalLookup,
    k4PrefixGroup0043TwistLookup, ?_,
    (List.all_eq_true.mp
      k4PrefixGroup0043_passes) support hsupport⟩
  intro p hp
  have hcovered := (List.all_eq_true.mp
    k4PrefixGroup0043_support_covered) support hsupport
  have hmem : p ∈
      k4PrefixGroup0043MaskPrimes :=
    of_decide_eq_true ((List.all_eq_true.mp hcovered) p hp)
  exact (List.all_eq_true.mp
    k4PrefixGroup0043_mask_primes_pass) p hmem

#print axioms k4PrefixGroup0043_certified

