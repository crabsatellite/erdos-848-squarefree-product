      15625 p (Erdos848.GeneratedHybridPaperRootCoverage.block3QrMaskWords p)
      (block3TwistQrMaskWords p) := by
  have hlocal := block3TwistMaskBatchLocalCertificate0112 hp
  by_cases hp947 : p = 947
