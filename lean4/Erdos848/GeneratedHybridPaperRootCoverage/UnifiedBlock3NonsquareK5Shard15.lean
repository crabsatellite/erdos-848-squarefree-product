import Erdos848.GeneratedHybridPaperRootCoverage.UnifiedBlock3K5ScanDefs

namespace Erdos848.GeneratedHybridPaperRootCoverage

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

theorem unifiedBlock3NonsquareK5Shard15Passes :
    unifiedBlock3K5ScanAt 3 61 16
        (Erdos848.globalMixedCoreIntersectWords ((Erdos848.HybridPaperDiagonalRegime.rootLookup .oneToTwoBillion) 61) block3NonsquareBaseWords) = true := by
  rfl

end Erdos848.GeneratedHybridPaperRootCoverage
