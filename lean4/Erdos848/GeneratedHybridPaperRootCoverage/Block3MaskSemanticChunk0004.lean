theorem block3MaskBatchCertificate0064
    {p : Nat} (hp : p ∈ block3SemanticBatchPrimes0064) :
    Erdos848.SquareWordMaskCertificate 15625 p
      (block3QrMaskWords p) := by
  have hlocal := block3MaskBatchLocalCertificate0064 hp
  by_cases hp739 : p = 739
  · subst p
    simpa [block3SemanticBatchWords0064, block3QrMaskWords] using hlocal
  by_cases hp743 : p = 743
  · subst p
    simpa [block3SemanticBatchWords0064, block3QrMaskWords] using hlocal
  · simp [block3SemanticBatchPrimes0064, semanticMaskPrimeGroupB3G0128, semanticMaskPrimeGroupB3G0129, hp739, hp743] at hp

