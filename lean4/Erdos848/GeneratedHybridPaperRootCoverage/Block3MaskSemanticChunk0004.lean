theorem block3MaskChunkCertificate0004
    {p : Nat} (hp : p ∈ block3SemanticChunkPrimes0004) :
    Erdos848.SquareWordMaskCertificate 15625 p
      (block3QrMaskWords p) := by
  simp only [block3SemanticChunkPrimes0004, List.mem_append] at hp
  exact match hp with
  | Or.inl hp =>
    match hp with
    | Or.inl hp =>
      match hp with
      | Or.inl hp =>
        match hp with
        | Or.inl hp =>
          match hp with
          | Or.inl hp =>
            match hp with
            | Or.inl hp =>
              match hp with
              | Or.inl hp =>
                match hp with
                | Or.inl hp =>
                  match hp with
                  | Or.inl hp =>
                    match hp with
                    | Or.inl hp =>
                      match hp with
                      | Or.inl hp =>
                        match hp with
                        | Or.inl hp =>
                          match hp with
                          | Or.inl hp =>
                            match hp with
                            | Or.inl hp =>
                              match hp with
                              | Or.inl hp =>
                                block3MaskBatchCertificate0064 hp
                              | Or.inr hp => block3MaskBatchCertificate0065 hp
                            | Or.inr hp => block3MaskBatchCertificate0066 hp
                          | Or.inr hp => block3MaskBatchCertificate0067 hp
                        | Or.inr hp => block3MaskBatchCertificate0068 hp
                      | Or.inr hp => block3MaskBatchCertificate0069 hp
                    | Or.inr hp => block3MaskBatchCertificate0070 hp
                  | Or.inr hp => block3MaskBatchCertificate0071 hp
                | Or.inr hp => block3MaskBatchCertificate0072 hp
              | Or.inr hp => block3MaskBatchCertificate0073 hp
            | Or.inr hp => block3MaskBatchCertificate0074 hp
          | Or.inr hp => block3MaskBatchCertificate0075 hp
        | Or.inr hp => block3MaskBatchCertificate0076 hp
      | Or.inr hp => block3MaskBatchCertificate0077 hp
    | Or.inr hp => block3MaskBatchCertificate0078 hp
  | Or.inr hp => block3MaskBatchCertificate0079 hp

