theorem qrMask_contains_square {p m root : ℕ}
    (hp : p ∈ supportPrimes)
    (hm : 1 ≤ m) (hmM : m ≤ 2401)
    (hnotDvd : ¬ p ∣ m) (hsquare : root ^ 2 ≡ m [MOD p]) :
    Erdos848.wordMaskTestBit (qrMaskWords p) (m - 1) = true := by
  have hpFlat : p ∈ maskGroups.flatten := by
    rw [maskGroups_flatten_eq]
    exact hp
  rcases List.mem_flatten.mp hpFlat with ⟨group, hgroup, hpGroup⟩
  simp only [maskGroups, List.mem_cons, List.not_mem_nil, or_false] at hgroup
  rcases hgroup with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
